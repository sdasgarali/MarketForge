# =============================================================================
# MarketForge — Environment Configuration (EXAMPLE / TEMPLATE)
# =============================================================================
# Copy to `.env` and fill in. NEVER commit the real `.env` (see .gitignore).
#
# ENV-SWITCHING SCHEME (global standard — packages/config enforces it):
#   A single `.env` supports TEST / DEV / PROD with NO code changes.
#   Set APP_ENV to one of TEST|DEV|PROD. For every canonical key `X`, the loader
#   reads `${APP_ENV}_X` first, then falls back to bare `X` if present.
#   Example: canonical `DATABASE_URL` -> loader reads `DEV_DATABASE_URL` when
#   APP_ENV=DEV. OS-specific paths use the `_WIN` / `_LINUX` suffix and the
#   loader picks by process.platform.
#
# Only keys relevant to the shared foundation + planned apps are listed. Provide
# the `${APP_ENV}_`-prefixed variant for whichever env you run; the bare
# (unprefixed) fallback is handy for local one-offs.
# =============================================================================

# --- Runtime selector (REQUIRED; must be TEST | DEV | PROD) -------------------
APP_ENV=DEV
NODE_ENV=development

# =============================================================================
# CORE INFRASTRUCTURE
# =============================================================================

# --- PostgreSQL (app connects as a NON-BYPASSRLS role; see packages/db) -------
DEV_DATABASE_URL=postgresql://marketforge_app:app_password@localhost:5432/marketforge
# TEST_DATABASE_URL=postgresql://marketforge_app:app_password@localhost:5432/marketforge_test
# PROD_DATABASE_URL=postgresql://marketforge_app:CHANGE_ME@db-host:5432/marketforge
# Individual parts (used by docker-compose to provision Postgres):
POSTGRES_USER=marketforge
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=marketforge
# Migration/admin connection (a role that can ENABLE/FORCE RLS + create policies;
# separate from the runtime app role, which must NOT have BYPASSRLS):
DEV_DATABASE_ADMIN_URL=postgresql://marketforge:CHANGE_ME_postgres@localhost:5432/marketforge

# --- Redis (BullMQ queue + cache) --------------------------------------------
DEV_REDIS_URL=redis://localhost:6379
# TEST_REDIS_URL=redis://localhost:6379/1
# PROD_REDIS_URL=rediss://:CHANGE_ME@redis-host:6379
REDIS_PASSWORD=

# =============================================================================
# AUTH — Clerk (ADR-002). Absent keys => enable DEV_AUTH_BYPASS below.
# =============================================================================
DEV_CLERK_SECRET_KEY=
DEV_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=
# When true AND APP_ENV != PROD, packages/auth injects a fake admin+org so the
# stack runs locally without Clerk. FORBIDDEN in PROD (loader will reject it).
DEV_AUTH_BYPASS=true

# =============================================================================
# SECRETS — envelope encryption (ADR-009, packages/secrets)
# =============================================================================
# Master KEK: 32 bytes, base64-encoded (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=
# Identifier stored alongside ciphertext so keys can be rotated / KMS-swapped.
ENCRYPTION_KEK_ID=local-dev-kek-v1
# Pepper for hashing inbound API keys (HMAC-SHA256). 32+ random bytes base64.
API_KEY_HASH_PEPPER=

# =============================================================================
# AI PROVIDERS (ADR-007 — task/cost routing behind adapters)
# =============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# fal.ai — image (Ideogram/Seedream/Flux) + video (Kling via fal queue API)
FAL_API_KEY=
# ElevenLabs — voice + subtitles
ELEVENLABS_API_KEY=

# =============================================================================
# PUBLISHING (ADR-003 — Ayrshare aggregator behind PublisherAdapter)
# =============================================================================
AYRSHARE_API_KEY=
# Business plan multi-profile key (per-brand profileKey); Premium is single-profile.
AYRSHARE_DOMAIN=

# =============================================================================
# STORAGE (ADR-006 — S3 primary, Google Drive mirror only)
# =============================================================================
# S3-compatible object store (AWS S3, MinIO, R2, Supabase Storage...)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marketforge-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Google Drive (mirror). Service-account JSON path OR inline credential ref.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# =============================================================================
# n8n INTEGRATION ENGINE (ADR-005 — queue mode, invoked per-job via webhook)
# =============================================================================
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# HMAC secret to sign backend->n8n and n8n->backend callbacks.
N8N_WEBHOOK_SECRET=CHANGE_ME_n8n_hmac
# Basic-auth / encryption for the n8n container (see docker-compose.yml):
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# =============================================================================
# NOTIFICATIONS (optional channels — packages/queue `notify` payloads)
# =============================================================================
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
SMTP_URL=

# =============================================================================
# MEDIA / VIDEO SCOPE (ADR-007 — Kling short-form via fal + GIF export + posters)
# =============================================================================
# Video is scoped to Kling short-form (<= VIDEO_SHORT_MAX_S) + GIF loops + poster
# images. Long-form / "big" video is PAUSED (skip + notify, no spend). Flip
# VIDEO_ALLOW_LONGFORM=true to re-enable long-form later.
VIDEO_ENABLED=true
VIDEO_ALLOW_LONGFORM=false
# Short-form cap (seconds). duration > cap OR longform request => paused.
VIDEO_SHORT_MAX_S=15
# GIF clips are short + SILENT; capped at GIF_MAX_S seconds, exported to .gif.
GIF_MAX_S=6
# Default fal video model when no modelHint is given (ADR-007: Kling via fal).
VIDEO_DEFAULT_MODEL=kling
# DEPRECATED legacy gate — mapped onto VIDEO_ENABLED for back-compat. Prefer
# VIDEO_ENABLED above. (Leave unset unless you rely on the old name.)
# WORKER_ENABLE_VIDEO=true

# =============================================================================
# OBSERVABILITY
# =============================================================================
SENTRY_DSN=
# Logger level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Pretty-print logs in dev (false => JSON lines for prod aggregators)
LOG_PRETTY=true

# =============================================================================
# OS-AWARE DATA DIRECTORIES (loader picks _WIN on Windows, _LINUX otherwise)
# =============================================================================
DEV_DATA_DIR_WIN=E:\\chapter 2\\N8N\\.data
DEV_DATA_DIR_LINUX=./.data
# PROD_DATA_DIR_LINUX=/var/lib/marketforge

# =============================================================================
# APP PORTS / URLS (apps added later; documented here for downstream agents)
# =============================================================================
API_PORT=8080
API_BASE_URL=http://localhost:8080
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000

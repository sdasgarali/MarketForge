{
  "name": "@marketforge/adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1099.0",
    "@aws-sdk/s3-request-presigner": "^3.1099.0",
    "@fal-ai/client": "^1.10.1",
    "@google/generative-ai": "^0.24.1",
    "@marketforge/config": "workspace:*",
    "@marketforge/contracts": "workspace:*",
    "@marketforge/logger": "workspace:*",
    "groq-sdk": "^1.4.1",
    "openai": "^7.2.0",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

{
  "name": "@marketforge/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@marketforge/adapters": "workspace:*",
    "@marketforge/config": "workspace:*",
    "@marketforge/contracts": "workspace:*",
    "@marketforge/db": "workspace:*",
    "@marketforge/logger": "workspace:*",
    "@marketforge/queue": "workspace:*",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.38.3",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.4.2",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

# =============================================================================
# MarketForge Web (apps/web) — PUBLIC env (NEXT_PUBLIC_*).
# Copy to `.env.local` for local dev. These are exposed to the browser bundle,
# so NEVER put secrets here. All have safe defaults; the app + `next build`
# succeed even if this file is absent.
# =============================================================================

# Base URL of the API service (apps/api). Trailing slash is trimmed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Dev auth bypass: "1" => run without Clerk (fake admin/org identity).
# Any other value (and a Clerk key present) => real Clerk auth.
NEXT_PUBLIC_DEV_AUTH_BYPASS=1

# Clerk publishable key (only used when DEV_AUTH_BYPASS != 1). NOT a secret.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
